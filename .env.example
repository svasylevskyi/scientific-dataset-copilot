# For host-based Python + Node development. Docker Compose sets its own internal hosts.
SDC_DATABASE_URL=postgresql+psycopg://sdc:sdc_local@127.0.0.1:5432/sdc
SDC_PUBLIC_URL=http://127.0.0.1:5173
SDC_SECURE_COOKIES=false
SDC_SMTP_HOST=127.0.0.1
SDC_SMTP_PORT=1025
SDC_MAIL_FROM=Scientific Dataset Copilot <hello@sdc.local>
SDC_SMTP_STARTTLS=false
SDC_SMTP_USERNAME=
SDC_SMTP_PASSWORD=

# Optional guided planning. Configure only on the API; never expose this key to Vite.
SDC_COPILOT_ENABLED=false
SDC_OPENAI_API_KEY=
SDC_COPILOT_DAILY_REQUESTS=20
SDC_COPILOT_DAILY_BUDGET_USD=2.00
